# ── Telegram ─────────────────────────────────────────────────────────────
# BotFather 给的 token。生产环境的 @zuchiangmaibot 的 token 在 ~/Dev/.env
# 的 4SEA_TELE_BOT_TOKEN,部署时映射过来。
TELEGRAM_BOT_TOKEN=

# 管理员 user id,逗号分隔。只有这些人能用 /report /reload /status
TELEGRAM_ADMIN_IDS=715297407

# 允许 bot 工作的群,逗号分隔。不在名单里的群 bot 会自动退出。
# -1001242897290 = 4Seas Community (@NomadsBase)
TELEGRAM_ALLOWED_CHATS=-1001242897290

# 每日播报发到哪个群。留空则用 TELEGRAM_ALLOWED_CHATS 的第一个。
DAILY_REPORT_CHAT_ID=-1001242897290


# ── 每日播报 ─────────────────────────────────────────────────────────────
DAILY_REPORT_TIME=19:00

# 播报哪一天的活动:0 = 当天,1 = 明天(晚上预告次日)。
DAILY_REPORT_OFFSET_DAYS=1

# 从起始日再往后多播几天。0 = 只播起始日那一天。
# 例:OFFSET=1 + AHEAD=0 → 只播明天;OFFSET=0 + AHEAD=6 → 今天起一周。
# 改完重启即可,不用重新导入(库里存的是未来 60 天)。
DAILY_REPORT_DAYS_AHEAD=0

# 排版:compact = 一行一场,标题即链接(默认);detailed = 地址/主办/人数/标签全给
DIGEST_STYLE=compact

# /events 手动查询默认看未来几天(始终从今天算起)
EVENTS_COMMAND_DAYS=7

# 目标日期没有任何活动时,是否仍然发一条"明天没有活动"。false = 静默跳过。
DAILY_REPORT_WHEN_EMPTY=true

TZ=Asia/Bangkok


# ── 活动数据源 (Social Layer) ────────────────────────────────────────────
SOLA_GROUP=4seas
SOLA_API_BASE=https://api.sola.day
SOLA_WEB_BASE=https://app.sola.day

# 每天几点从 Social Layer 导入活动到本地库。逗号分隔可配多个。
# 至少要有一个早于 DAILY_REPORT_TIME,保证播报读到的是最新数据。
# 导入是幂等的,重复执行不会产生重复数据。
SYNC_TIMES=08:30,18:30

# 一次导入未来多少天的活动。库里存的范围比播报范围大得多,
# 这样改 DAILY_REPORT_DAYS_AHEAD 不需要重新导入。
SYNC_HORIZON_DAYS=60

# 启动时补一次导入(冷启动/重新部署后库是空的)。
SYNC_ON_STARTUP=true


# ── 问答 LLM ─────────────────────────────────────────────────────────────
# 主力:DeepSeek。~/Dev/.env 里叫 DEEP_SEEK_API_LKEY(注意原变量名有拼写错误)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 兜底:DeepSeek 不可用时自动切换。留空则不兜底。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini


# ── 限流 ─────────────────────────────────────────────────────────────────
# 每个用户每小时最多问几次
ASK_RATE_PER_HOUR=10
# 关键词触发的默认冷却(秒),keywords.yaml 里可以逐条覆盖
KEYWORD_DEFAULT_COOLDOWN=3600


# ── 其它 ─────────────────────────────────────────────────────────────────
DB_PATH=data/bot.sqlite3
LOG_LEVEL=INFO
