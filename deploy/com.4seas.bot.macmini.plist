<?xml version="1.0" encoding="UTF-8"?>
<!--
  4Seas Bot on the Mac mini. Migrated off 149.28.158.244 on 2026-09-10.

  Layout mirrors the 244 host: immutable release dirs + a `current` symlink,
  with data and .env symlinked into the release from ../../shared/data and
  ../../env, so a release swap never touches persistent state.

  Only one process may poll a Telegram token. Before starting this, make sure
  244's `4seas-app@autobot` is stopped and disabled, or both will get 409.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.4seas.bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jason/4seas-autobot/current/.venv/bin/python</string>
        <string>-m</string>
        <string>bot</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jason/4seas-autobot/current</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/jason/4seas-autobot/logs/bot.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jason/4seas-autobot/logs/bot.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
